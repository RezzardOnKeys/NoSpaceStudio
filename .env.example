# Copy this file to ".env" and fill in the values.
# ".env" is ignored by git – never commit real keys.

# Supabase. Where to find the values: docs/SUPABASE-SETUP.md, step 4.
# Both values are safe to expose in the
# browser. NEVER put the service_role key here or anywhere in the frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Origin that serves the games/ folder. Games run on a separate origin so
# they can never read the launcher's login session.
# Local: second dev server. Production: the games Cloudflare Pages project.
VITE_GAMES_BASE_URL=http://localhost:5174
